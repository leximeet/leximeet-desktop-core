            },
            "grantToken": {
              "type": "string",
              "minLength": 32,
              "maxLength": 128
            },
            "workspace": {
              "$ref": "https://leximeet.github.io/contracts/reading-domain.v1.schema.json#/$defs/WorkspaceIdentity"
            },
            "deadlineAt": {
