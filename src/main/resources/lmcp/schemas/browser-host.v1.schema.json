        "invocationId"
      ],
      "additionalProperties": false
    },
    "cancelOperationResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "cancelled",
            "already-completed",
            "unknown"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
