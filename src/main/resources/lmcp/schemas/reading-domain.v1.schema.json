{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leximeet.github.io/contracts/reading-domain.v1.schema.json",
  "title": "词身份与采集只读结构：由 LMSP 共享模型裁剪生成",
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "Version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "\\.[0-9]{3}Z$",
      "maxLength": 24
    },
    "Day": {
      "type": "string",
      "format": "date",
      "maxLength": 10
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "WordRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dictionary"
            },
            "entryId": {
              "$ref": "#/$defs/Uuid"
            },
            "release": {
              "$ref": "#/$defs/Version"
            },
            "entrySchema": {
              "const": "leximeet.entry.v2"
            }
          },
          "required": [
            "kind",
            "entryId",
            "release",
            "entrySchema"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "custom"
            },
            "customId": {
              "$ref": "#/$defs/Uuid"
            },
            "headword": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "language": {
              "const": "en"
            }
          },
          "required": [
            "kind",
            "customId",
            "headword",
            "language"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "WorkspaceIdentity": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Uuid"
        },
        "generation": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "workspaceId",
        "generation"
      ],
      "additionalProperties": false
    },
    "UuidRead": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "RevisionRead": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "VersionRead": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "TimestampRead": {
      "type": "string",
      "format": "date-time",
      "pattern": "\\.[0-9]{3}Z$",
      "maxLength": 24
    },
    "TimeZoneRead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "WordRefRead": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dictionary"
            },
            "entryId": {
              "$ref": "#/$defs/UuidRead"
            },
            "release": {
              "$ref": "#/$defs/VersionRead"
            },
            "entrySchema": {
              "const": "leximeet.entry.v2"
            }
          },
          "required": [
            "kind",
            "entryId",
            "release",
            "entrySchema"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "custom"
            },
            "customId": {
              "$ref": "#/$defs/UuidRead"
            },
            "headword": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "language": {
              "const": "en"
            }
          },
          "required": [
            "kind",
            "customId",
            "headword",
            "language"
          ],
          "additionalProperties": true
        }
      ]
    },
    "OriginRead": {
      "type": "object",
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/UuidRead"
        },
        "clientKind": {
          "type": "string",
          "enum": [
            "desktop",
            "browser"
          ]
        }
      },
      "required": [
        "deviceId",
        "clientKind"
      ],
      "additionalProperties": true
    },
    "NotebookDataRead": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "name",
        "color",
        "position"
      ],
      "additionalProperties": true
    },
    "RangeRead": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": true
    },
    "EncounterDataRead": {
      "type": "object",
      "properties": {
        "word": {
          "$ref": "#/$defs/WordRefRead"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "originalSentence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "savedExcerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "occurrenceRanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RangeRead"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": false
        },
        "excerptRanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RangeRead"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": false
        },
        "annotation": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string",
              "minLength": 0,
              "maxLength": 20000
            }
          },
          "required": [
            "note"
          ],
          "additionalProperties": true
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "web",
                "manual",
                "clipboard"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 0,
              "maxLength": 300
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "title",
            "url"
          ],
          "additionalProperties": true
        },
        "timeZone": {
          "$ref": "#/$defs/TimeZoneRead"
        },
        "occurredAt": {
          "$ref": "#/$defs/TimestampRead"
        },
        "origin": {
          "$ref": "#/$defs/OriginRead"
        },
        "collectionIntent": {
          "type": "string",
          "enum": [
            "collect",
            "context-only"
          ]
        }
      },
      "required": [
        "word",
        "surface",
        "originalSentence",
        "savedExcerpt",
        "occurrenceRanges",
        "excerptRanges",
        "annotation",
        "source",
        "timeZone",
        "occurredAt",
        "origin",
        "collectionIntent"
      ],
      "additionalProperties": true
    },
    "NotebookRecordRead": {
      "type": "object",
      "properties": {
        "entityType": {
          "const": "notebook"
        },
        "entityId": {
          "$ref": "#/$defs/UuidRead"
        },
        "revision": {
          "$ref": "#/$defs/RevisionRead"
        },
        "deletedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimestampRead"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "$ref": "#/$defs/NotebookDataRead"
        }
      },
      "required": [
        "entityType",
        "entityId",
        "revision",
        "deletedAt",
        "data"
      ],
      "additionalProperties": true
    },
    "EncounterRecordRead": {
      "type": "object",
      "properties": {
        "entityType": {
          "const": "encounter"
        },
        "entityId": {
          "$ref": "#/$defs/UuidRead"
        },
        "revision": {
          "$ref": "#/$defs/RevisionRead"
        },
        "deletedAt": {
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/EncounterDataRead"
        }
      },
      "required": [
        "entityType",
        "entityId",
        "revision",
        "deletedAt",
        "data"
      ],
      "additionalProperties": true
    },
    "ErrorRead": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "retryable": {
          "type": "boolean"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": true
    }
  }
}
