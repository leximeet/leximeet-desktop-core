<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>app.leximeet</groupId>
  <artifactId>leximeet-core</artifactId>
  <version>1.0.0</version>
  <name>LexiMeet Desktop Core</name>
  <description>词遇桌面的本机学习与资料事务核心，使用 JDK 21、SQLite 和 FSRS-6。</description>
  <url>https://github.com/leximeet/leximeet-desktop-core</url>
  <licenses>
    <license>
      <name>AGPL-3.0-only</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <url>https://github.com/leximeet/leximeet-desktop-core</url>
    <connection>scm:git:https://github.com/leximeet/leximeet-desktop-core.git</connection>
  </scm>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 固定归档时间；随正式版本更新，避免机器时间改变同源重建结果。 -->
    <project.build.outputTimestamp>2026-10-04T00:00:00Z</project.build.outputTimestamp>
    <spring-boot.version>3.5.16</spring-boot.version>
    <spotless.version>3.10.3</spotless.version>
    <google-java-format.version>1.27.0</google-java-format.version>
    <cyclonedx.version>2.9.1</cyclonedx.version>
  </properties>
  <dependencies>
    <!-- 只引入 Boot 容器与显式配置所需 Spring Context；不引入 Servlet、Actuator 或自动配置扫描。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.50.3.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.21.4</version>
    </dependency>
    <!-- 固定 FSRS-6 的 Java 参考实现；业务层关闭随机模糊，保证撤销重放可复现。 -->
    <dependency>
      <groupId>io.github.open-spaced-repetition</groupId>
      <artifactId>fsrs</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.21.4</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.17</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>leximeet-core</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- 分发可执行 Jar 时一同保留项目许可与明确的第三方声明。 -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF/leximeet</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>THIRD_PARTY_LICENSES/**</include>
          <include>docs/依赖与许可证.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- 仅排版；不启用自动重构、字符串/Javadoc 重流或修改冻结协议资源。 -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
              <reflowLongStrings>false</reflowLongStrings>
              <formatJavadoc>false</formatJavadoc>
            </googleJavaFormat>
            <trimTrailingWhitespace />
            <endWithNewline />
          </java>
          <formats>
            <format>
              <includes>
                <include>*.md</include>
                <include>docs/**/*.md</include>
                <include>*.txt</include>
                <include>.gitignore</include>
                <include>.editorconfig</include>
              </includes>
              <trimTrailingWhitespace />
              <endWithNewline />
            </format>
          </formats>
        </configuration>
        <executions>
          <execution>
            <id>format-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx.version}</version>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.6</schemaVersion>
          <includeCompileScope>true</includeCompileScope>
          <includeRuntimeScope>true</includeRuntimeScope>
          <includeProvidedScope>false</includeProvidedScope>
          <includeSystemScope>false</includeSystemScope>
          <includeTestScope>false</includeTestScope>
          <includeLicenseText>true</includeLicenseText>
          <outputFormat>all</outputFormat>
          <outputName>bom</outputName>
          <skipAttach>true</skipAttach>
        </configuration>
        <executions>
          <execution>
            <id>dependency-sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>require-jdk-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>词遇当前兼容发布单元固定 JDK 21，请将 JAVA_HOME 与 Maven Runner JRE 设为 21。</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <!-- 标准 Boot 可执行 jar 保留每个依赖的 spring.factories、SPI 与许可证，不再混合扁平资源。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>app.leximeet.core.Main</mainClass>
          <!-- 桌面只用标准 java -jar；不注入未在运行时依赖 SBOM 中的分层提取工具。 -->
          <includeTools>false</includeTools>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
